{
  "name": "agentic-language-development",
  "version": "0.1.32",
  "private": true,
  "description": "Research infrastructure for grounded, auditable emergent agent communication",
  "type": "module",
  "workspaces": [
    "packages/*",
    "twins/packs/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=artifacts/vitest-junit.xml",
    "test:mode-r": "node scripts/run-mode-r-smoke.mjs",
    "test:watch": "vitest",
    "design:e03": "npm run build && node scripts/run-e03-design-simulation.mjs",
    "registration:e03": "npm run build && node scripts/build-e03-registration.mjs",
    "lint": "eslint packages twins",
    "book:research": "node scripts/build-research-book.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "check": "npm run lint && npm run lint:contracts && npm run lint:crypto-boundary && npm run lint:research-console && npm run lint:readiness && npm run lint:acceptance-coverage && npm run lint:api-docs && npm run build && npm test && npm run scan:secrets && npm run audit:dependencies",
    "check:ci": "npm run lint && npm run lint:contracts && npm run lint:crypto-boundary && npm run lint:research-console && npm run lint:readiness && npm run lint:acceptance-coverage && npm run lint:api-docs && npm run build && npm run test:ci && npm run scan:secrets",
    "lint:contracts": "node scripts/lint-learner-contracts.mjs",
    "lint:crypto-boundary": "node scripts/lint-crypto-boundary.mjs",
    "lint:research-console": "node scripts/check-research-console.mjs",
    "lint:readiness": "node scripts/check-readiness-gates.mjs",
    "lint:acceptance-coverage": "node scripts/check-acceptance-coverage.mjs",
    "lint:api-docs": "node scripts/check-api-docs.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "marked": "^18.0.11",
    "pdfjs-dist": "^6.2.108",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "read-as-book": "https://codeload.github.com/Ethical-Tech-CoLab/read-as-book/tar.gz/d1d1ec6193867c13637636fc03e538c27d95261c"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}

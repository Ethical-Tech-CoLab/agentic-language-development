    {
      "from": "gateway",
      "to": "evidence-writer",
      "transport": "private-unix-socket",
      "capability": "gateway-writer"
    },
    {
      "from": "controller-scenario",
      "to": "evidence-writer",
      "transport": "private-unix-socket",
      "capability": "controller-writer"
    },
    {
      "from": "checkpoint",
      "to": "evidence-writer",
      "transport": "private-unix-socket",
      "capability": "checkpoint-writer"
    },
    {
      "from": "simulated-anchor",
      "to": "evidence-writer",
      "transport": "private-unix-socket",
      "capability": "anchor-writer"
    }
  ],
  "callAdditions": [
    {
      "from": "controller-scenario",
      "to": "audit-interpreter",
      "transport": "authenticated-control-plane",
      "purpose": "delayed-audit-batch-request-only"
    },
